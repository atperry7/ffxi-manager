{
  "name": "PlayOnline Play Screen",
  "templatePath": "PlayOnline/play_screen",
  "elementType": "button",
  "associatedStep": "CharacterSelection",
  "confidenceThreshold": 0.80,
  "tolerance": 5,
  "version": "2.0.0",
  "navigation": {
    "type": "Hybrid",
    "description": "Navigate to and activate Play button",
    "sequence": [
      {
        "action": "Tab",
        "count": 1,
        "delayMs": 100,
        "description": "Tab to Play button"
      },
      {
        "action": "Enter",
        "count": 1,
        "delayMs": 500,
        "description": "Activate Play button"
      }
    ],
    "fallback": {
      "type": "RelativeClick",
      "clickOffset": {
        "x": 0.5,
        "y": 0.5,
        "description": "Click center of Play button"
      }
    },
    "postNavigationDelayMs": 2000
  },
  "action": {
    "type": "click",
    "clickOffset": { "x": 360, "y": 240 },
    "description": "Play button"
  }
}