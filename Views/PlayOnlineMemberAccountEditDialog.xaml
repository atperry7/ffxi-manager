<Window x:Class="FFXIManager.Views.PlayOnlineMemberAccountEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Height="650"
        Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{Binding DialogTitle}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,0,0,20"/>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Account Name -->
                <Label Content="Account Name (Optional):" Target="{Binding ElementName=AccountNameTextBox}"/>
                <TextBox x:Name="AccountNameTextBox"
                         Text="{Binding Account.AccountName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Optional name to identify this account"/>

                <!-- POL Member Slot -->
                <Label Content="PlayOnline Member Slot:" Target="{Binding ElementName=POLSlotComboBox}" Margin="0,10,0,0"/>
                <ComboBox x:Name="POLSlotComboBox"
                          ItemsSource="{Binding AvailablePOLSlots}"
                          SelectedItem="{Binding Account.POLMemberSlot}"
                          ToolTip="PlayOnline Member Slot Number (1-4)"/>

                <!-- FFXI Character Slot -->
                <Label Content="FFXI Character Slot:" Target="{Binding ElementName=FFXISlotComboBox}" Margin="0,10,0,0"/>
                <ComboBox x:Name="FFXISlotComboBox"
                          ItemsSource="{Binding AvailableFFXISlots}"
                          SelectedItem="{Binding Account.FFXICharacterSlot}"
                          ToolTip="FFXI Character Slot Number (1-16)"/>

                <!-- Password -->
                <Label Content="PlayOnline SE Password:" Target="{Binding ElementName=PasswordBox}" Margin="0,10,0,0"/>
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             ToolTip="Your PlayOnline Square Enix password (securely stored using Windows Credential Manager)"/>

                <!-- OTP Configuration -->
                <Label Content="One-Time Password (OTP):" Margin="0,15,0,0"/>
                <CheckBox x:Name="OTPEnabledCheckBox"
                          Content="Enable OTP for this account"
                          IsChecked="{Binding Account.OTPConfiguration.IsEnabled}"
                          Margin="0,5,0,0"
                          ToolTip="Check this if you use a Security Token or Software Token"/>

                <!-- OTP Authentication Key Input -->
                <StackPanel Visibility="{Binding Account.OTPConfiguration.IsEnabled, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,10,0,0">
                    <Label Content="Square Enix Authentication Key:" Target="{Binding ElementName=AuthKeyTextBox}"/>
                    <TextBox x:Name="AuthKeyTextBox"
                             Text="{Binding AuthenticationKeyInput, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="AuthKeyTextBox_TextChanged"
                             ToolTip="Enter your 32-character Square Enix authentication key (with or without spaces)"
                             MaxLength="39"
                             CharacterCasing="Upper"/>

                    <TextBlock Text="Example: OBQV O3CU GA4V A6SN PJGW Q33B I5DF EVKW"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontStyle="Italic"
                               Margin="0,2,0,0"/>

                    <TextBlock x:Name="OTPSecretStatusText"
                               Text="🔐 OTP secret is securely stored"
                               FontSize="10"
                               Foreground="{DynamicResource SuccessBrush}"
                               Margin="0,5,0,0"
                               Visibility="{Binding Account.OTPConfiguration.HasStoredSecret, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>

                <!-- Information Panel -->
                <Border Background="{DynamicResource InfoBackgroundBrush}"
                        BorderBrush="{DynamicResource InfoBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,20,0,0"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="💡 About PlayOnline Member Accounts"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InfoTextBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource InfoTextBrush}"
                                   FontSize="11">
                            <Run Text="These settings will be used for future auto-login functionality. Each profile can have up to 4 accounts (one per POL Member Slot)."/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="• POL Member Slot: The slot number in PlayOnline Viewer"/>
                            <LineBreak/>
                            <Run Text="• FFXI Character Slot: The character position in FFXI"/>
                            <LineBreak/>
                            <Run Text="• Password: Your Square Enix account password (securely encrypted)"/>
                            <LineBreak/>
                            <Run Text="• OTP: Enable if you use Security Token authentication"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="OK"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Width="80"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="OkButton_Click"/>
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    Width="80"
                    Height="30"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>