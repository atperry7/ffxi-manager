<UserControl x:Class="FFXIManager.Views.PlayOnlineMemberAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <!-- Login Now for selected account -->
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding LoginNowCommand}" />
        <!-- Add to Queue for selected account -->
        <KeyBinding Key="Q" Modifiers="Ctrl" Command="{Binding AddToQueueCommand}" />
        <!-- Add new account -->
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding AddAccountCommand}" />
        <!-- Refresh accounts -->
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <!-- Edit selected account -->
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditAccountCommand}" />
        <!-- Delete selected account -->
        <KeyBinding Key="Delete" Command="{Binding DeleteAccountCommand}" />
    </UserControl.InputBindings>

    <GroupBox Header="{Binding AccountsHeader}" MinHeight="150">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- No Profile Selected Message -->
            <TextBlock Grid.Row="0"
                       Text="Select a backup profile to manage PlayOnline Member Accounts"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Visibility="{Binding HasProfileSelected, Converter={StaticResource InverseBoolToVisConverter}}"/>

            <!-- Accounts DataGrid -->
            <DataGrid Grid.Row="0"
                      Style="{StaticResource DataGridBase}"
                      ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding SelectedAccount}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      Visibility="{Binding HasProfileSelected, Converter={StaticResource BoolToVisConverter}}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✏️ Edit Account"
                                  Command="{Binding EditAccountCommand}"
                                  FontWeight="Bold"/>
                        <MenuItem Header="🗑️ Delete Account"
                                  Command="{Binding DeleteAccountCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Account Name"
                                        Binding="{Binding AccountName}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=AccountName}" Value="">
                                        <Setter Property="Text" Value="(Unnamed)"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="POL Slot"
                                        Binding="{Binding POLMemberSlot}"
                                        Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenteredTextCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="FFXI Slot"
                                        Binding="{Binding FFXICharacterSlot}"
                                        Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenteredTextCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Password" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Not Set"/>
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=HasStoredPassword}" Value="True">
                                                    <Setter Property="Text" Value="Secured"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter Property="FontStyle" Value="Normal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="OTP" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Width="70">
                                        <TextBlock Text="{Binding OTPCodeDisplay}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Margin="0,0,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOTPEnabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ProgressBar Value="{Binding OTPTimeRemaining}"
                                                     Height="3"
                                                     Maximum="100"
                                                     Minimum="0"
                                                     Background="Transparent"
                                                     BorderThickness="0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOTPCodeVisible}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                    <Button Content="👁️"
                                            Style="{StaticResource CircularSmallButton}"
                                            Background="{DynamicResource InfoBrush}"
                                            Command="{Binding DataContext.ToggleOTPVisibilityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Show/Hide OTP Code"
                                            AutomationProperties.Name="Show/Hide OTP Code"
                                            Margin="2,0,0,0"
                                            Visibility="{Binding IsOTPEnabled, Converter={StaticResource BoolToVisConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="🚀"
                                            Style="{StaticResource CircularSmallButton}"
                                            Background="{DynamicResource SuccessBrush}"
                                            Command="{Binding DataContext.LoginNowParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Login Now (immediate single account login)"
                                            AutomationProperties.Name="Login Now"
                                            Margin="2"/>
                                    <Button Content="⏭️"
                                            Style="{StaticResource CircularSmallButton}"
                                            Background="{DynamicResource PrimaryBrush}"
                                            Command="{Binding DataContext.AddToQueueParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Add to Auto-Login Queue"
                                            AutomationProperties.Name="Add to Queue"
                                            Margin="2"/>
                                    <Button Content="✏️"
                                            Style="{StaticResource CircularSmallButton}"
                                            Background="{DynamicResource WarningBrush}"
                                            Command="{Binding DataContext.EditAccountParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Edit this account"
                                            AutomationProperties.Name="Edit Account"
                                            Margin="2"/>
                                    <Button Content="🗑️"
                                            Style="{StaticResource CircularSmallButton}"
                                            Background="{DynamicResource DangerBrush}"
                                            Command="{Binding DataContext.DeleteAccountParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Delete this account"
                                            AutomationProperties.Name="Delete Account"
                                            Margin="2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="5,5,0,0"
                        Visibility="{Binding HasProfileSelected, Converter={StaticResource BoolToVisConverter}}">
                <Button Content="➕"
                        Style="{StaticResource CircularPrimaryButton}"
                        Command="{Binding AddAccountCommand}"
                        IsEnabled="{Binding CanAddAccount}"
                        AutomationProperties.Name="Add Account"
                        Margin="0,0,5,0">
                    <Button.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Add a new PlayOnline Member Account"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanAddAccount}" Value="False">
                                                <Setter Property="Text" Value="Maximum of 20 accounts allowed per profile"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button Content="🔍"
                        Style="{StaticResource CircularWarningButton}"
                        Command="{Binding RecoverCredentialsCommand}"
                        ToolTip="Recover orphaned credentials from Windows Credential Manager"
                        AutomationProperties.Name="Recover Credentials"
                        Margin="0,0,5,0"/>
                <Button Content="🔄"
                        Style="{StaticResource CircularInfoButton}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Refresh"
                        AutomationProperties.Name="Refresh Accounts"/>
            </StackPanel>

            <!-- Loading Indicator -->
            <ProgressBar Grid.Row="0"
                         IsIndeterminate="True"
                         Height="3"
                         VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>
        </Grid>
    </GroupBox>
</UserControl>