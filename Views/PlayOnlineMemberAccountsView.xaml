<UserControl x:Class="FFXIManager.Views.PlayOnlineMemberAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <GroupBox Header="{Binding AccountsHeader}" MinHeight="150">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- No Profile Selected Message -->
            <TextBlock Grid.Row="0"
                       Text="Select a backup profile to manage PlayOnline Member Accounts"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Visibility="{Binding HasProfileSelected, Converter={StaticResource InverseBoolToVisConverter}}"/>

            <!-- Accounts DataGrid -->
            <DataGrid Grid.Row="0"
                      Style="{StaticResource DataGridBase}"
                      ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding SelectedAccount}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      Visibility="{Binding HasProfileSelected, Converter={StaticResource BoolToVisConverter}}"
                      MaxHeight="200">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✏️ Edit Account"
                                  Command="{Binding EditAccountCommand}"
                                  FontWeight="Bold"/>
                        <MenuItem Header="🗑️ Delete Account"
                                  Command="{Binding DeleteAccountCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Account Name"
                                        Binding="{Binding AccountName}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=AccountName}" Value="">
                                        <Setter Property="Text" Value="(Unnamed)"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="POL Slot"
                                        Binding="{Binding POLMemberSlot}"
                                        Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="FFXI Slot"
                                        Binding="{Binding FFXICharacterSlot}"
                                        Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Password" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Not Set"/>
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=HasStoredPassword}" Value="True">
                                                    <Setter Property="Text" Value="Secured"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter Property="FontStyle" Value="Normal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="OTP" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Width="70">
                                        <TextBlock Text="{Binding OTPCodeDisplay}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Margin="0,0,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOTPEnabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ProgressBar Value="{Binding OTPTimeRemaining}"
                                                     Height="3"
                                                     Maximum="100"
                                                     Minimum="0"
                                                     Background="Transparent"
                                                     BorderThickness="0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOTPCodeVisible}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                    <Button Content="👁️"
                                            Style="{StaticResource InfoIconButton}"
                                            Command="{Binding DataContext.ToggleOTPVisibilityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Show/Hide OTP Code"
                                            Margin="4,0,0,0"
                                            Width="20"
                                            Height="20"
                                            FontSize="10"
                                            Visibility="{Binding IsOTPEnabled, Converter={StaticResource BoolToVisConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️"
                                            Style="{StaticResource WarningIconButton}"
                                            Command="{Binding DataContext.EditAccountParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Edit this account"
                                            Margin="2"/>
                                    <Button Content="🗑️"
                                            Style="{StaticResource DangerIconButton}"
                                            Command="{Binding DataContext.DeleteAccountParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Delete this account"
                                            Margin="2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="5,5,0,0"
                        Visibility="{Binding HasProfileSelected, Converter={StaticResource BoolToVisConverter}}">
                <Button Content="➕ Add Account"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddAccountCommand}"
                        IsEnabled="{Binding CanAddAccount}"
                        Width="120"
                        Height="30"
                        Margin="0,0,5,0">
                    <Button.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Add a new PlayOnline Member Account"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanAddAccount}" Value="False">
                                                <Setter Property="Text" Value="Maximum of 4 accounts allowed per profile"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button Content="🔄 Refresh"
                        Style="{StaticResource InfoButton}"
                        Command="{Binding RefreshCommand}"
                        Width="100" Height="30"/>
            </StackPanel>

            <!-- Loading Indicator -->
            <ProgressBar Grid.Row="0"
                         IsIndeterminate="True"
                         Height="3"
                         VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>
        </Grid>
    </GroupBox>
</UserControl>