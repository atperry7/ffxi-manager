<UserControl x:Class="FFXIManager.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FFXIManager.Converters">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:NotificationTypeToBrushConverter x:Key="NotificationTypeToBrush"/>
        <converters:NotificationTypeToIconConverter x:Key="NotificationTypeToIcon"/>
        
        <!-- A toggle button style that looks like plain text -->
        <Style x:Key="TextToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Border Background="{DynamicResource HeaderBackgroundBrush}" Padding="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Loading Indicator -->
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                        Margin="0,0,10,0">
                <!-- Animated Loading Spinner -->
                <Border Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" 
                             Stroke="{DynamicResource AccentBrush}" 
                             StrokeThickness="2"
                             StrokeDashArray="4,2" 
                             StrokeDashOffset="0">
                        <Ellipse.RenderTransform>
                            <RotateTransform CenterX="5" CenterY="5"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="RenderTransform.Angle"
                                            From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Border>
            </StackPanel>
            
            <!-- Status Message acts as the toggle; click to open history -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <ToggleButton x:Name="StatusToggle"
                              Style="{StaticResource TextToggle}"
                              IsChecked="{Binding IsHistoryOpen, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentMessageType, Converter={StaticResource NotificationTypeToIcon}}"
                                   Foreground="{Binding CurrentMessageType, Converter={StaticResource NotificationTypeToBrush}}"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding CurrentMessageType, Converter={StaticResource NotificationTypeToBrush}}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text=" ▼" Foreground="#C1C7CD"/>
                    </StackPanel>
                </ToggleButton>

                <Popup PlacementTarget="{Binding ElementName=StatusToggle}"
                       Placement="Top"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       IsOpen="{Binding IsChecked, ElementName=StatusToggle}">
                    <Border Background="{DynamicResource HeaderBackgroundBrush}"
                            BorderBrush="#4A5568" BorderThickness="1"
                            CornerRadius="4"
                            Padding="8" MinWidth="420">
                        <StackPanel>
                            <TextBlock Text="Recent Messages" FontWeight="SemiBold" Foreground="#C1C7CD"/>
                            <Separator Margin="0,4,0,6"/>
                            <ScrollViewer MaxHeight="240">
                                <ItemsControl ItemsSource="{Binding RecentMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="[" Foreground="#9AA0A6"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" Foreground="#9AA0A6"/>
                                                <TextBlock Text="] " Foreground="#9AA0A6"/>
                                                <TextBlock Text="{Binding Type, Converter={StaticResource NotificationTypeToIcon}}"
                                                           Foreground="{Binding Type, Converter={StaticResource NotificationTypeToBrush}}"
                                                           Margin="2,0"/>
                                                <TextBlock Text=": " Foreground="#C1C7CD"/>
                                                <TextBlock Text="{Binding Message}"
                                                           Foreground="{Binding Type, Converter={StaticResource NotificationTypeToBrush}}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            
            <!-- Backup Info -->
            <Border Grid.Column="2" BorderBrush="#4A5568" BorderThickness="1,0,0,0"
                    Padding="10,0,10,0" Margin="10,0,0,0">
                <TextBlock Text="{Binding BackupInfo}" 
                           Foreground="#C1C7CD"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- App Version -->
            <Border Grid.Column="3" BorderBrush="#4A5568" BorderThickness="1,0,0,0"
                    Padding="10,0,10,0" Margin="10,0,0,0">
                <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" 
                           Foreground="#C1C7CD"
                           FontSize="11"
                           VerticalAlignment="Center"
                           ToolTip="Application Version"/>
            </Border>

            <!-- Removed separate Message History column; integrated into column 1 -->
        </Grid>
    </Border>
</UserControl>
