<Window x:Class="FFXIManager.Views.TemplateViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Template Viewer"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource CustomWindowStyle}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="{Binding TemplateName, StringFormat='Template: {0}'}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,0,0,10"/>

        <!-- Info Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="Size: "/>
                    <Run Text="{Binding TemplateImageWidth, StringFormat='{}{0:F0}', Mode=OneWay}"/>
                    <Run Text=" × "/>
                    <Run Text="{Binding TemplateImageHeight, StringFormat='{}{0:F0}', Mode=OneWay}"/>
                    <Run Text=" pixels"/>
                </TextBlock>
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="Click Points: "/>
                    <Run Text="{Binding ClickMarkers.Count, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Template Image with Click Markers -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,10">
            <Border Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Viewbox Stretch="Uniform" MaxWidth="850" MaxHeight="500">
                    <Grid>
                        <!-- Template Image -->
                        <Image Source="{Binding TemplateImage}"
                               Width="{Binding TemplateImageWidth}"
                               Height="{Binding TemplateImageHeight}"
                               Stretch="None"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                        <!-- Canvas overlay with same dimensions for pixel-perfect marker positioning -->
                        <Canvas x:Name="TemplateCanvas"
                                Width="{Binding TemplateImageWidth}"
                                Height="{Binding TemplateImageHeight}"
                                ClipToBounds="True"
                                Background="Transparent">
                            <!-- Click Markers -->
                            <ItemsControl ItemsSource="{Binding ClickMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- Outer Glow -->
                                            <Ellipse Width="24" Height="24"
                                                     Fill="{Binding MarkerColor}"
                                                     Opacity="0.3"
                                                     Margin="-12,-12,0,0"/>

                                            <!-- Marker Circle -->
                                            <Ellipse Width="18" Height="18"
                                                     Fill="{Binding MarkerColor}"
                                                     Stroke="White"
                                                     StrokeThickness="2"
                                                     Margin="-9,-9,0,0"/>

                                            <!-- Label -->
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="-9,-9,0,0"
                                                       Width="18"
                                                       Height="18"
                                                       TextAlignment="Center"/>

                                            <!-- Tooltip -->
                                            <Grid.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontWeight="Bold"/>
                                                        <TextBlock>
                                                            <Run Text="Position: ("/>
                                                            <Run Text="{Binding X, StringFormat='{}{0:F0}'}"/>
                                                            <Run Text=", "/>
                                                            <Run Text="{Binding Y, StringFormat='{}{0:F0}'}"/>
                                                            <Run Text=")"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Grid.ToolTip>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Border>
        </ScrollViewer>

        <!-- Legend -->
        <Border Grid.Row="3"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="0,0,0,10"
                Visibility="{Binding ClickMarkers.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Click Points:"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,5"/>
                <ItemsControl ItemsSource="{Binding ClickMarkers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="12" Height="12"
                                         Fill="{Binding MarkerColor}"
                                         Margin="0,0,6,0"/>
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                                    <Run Text="{Binding Label}" FontWeight="Bold"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Description}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding Status}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11"/>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="5"
                Content="Close"
                Width="100"
                Height="32"
                HorizontalAlignment="Right"
                Style="{StaticResource SecondaryButton}"
                IsCancel="True"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
