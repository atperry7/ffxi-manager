<Window x:Class="FFXIManager.Views.CredentialRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Recover Orphaned Credentials"
        Height="500"
        Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Recover Orphaned Credentials"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,0,0,10"/>

        <!-- Description -->
        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,0,20">
            <Run Text="These credentials were found in Windows Credential Manager but are not linked to any current account."/>
            <LineBreak/>
            <Run Text="Select a credential below to restore it to a new account. No secrets will be displayed."/>
        </TextBlock>

        <!-- No Orphaned Credentials Message -->
        <TextBlock Grid.Row="2"
                   Text="✓ No orphaned credentials found. All stored credentials are linked to active accounts."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontStyle="Italic"
                   Foreground="{DynamicResource SuccessBrush}"
                   Visibility="{Binding HasNoOrphanedCredentials, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- Credentials DataGrid -->
        <DataGrid Grid.Row="2"
                  Style="{StaticResource DataGridBase}"
                  ItemsSource="{Binding OrphanedCredentials}"
                  SelectedItem="{Binding SelectedOrphanedCredential}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  Visibility="{Binding HasOrphanedCredentials, Converter={StaticResource BoolToVisConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Account ID"
                                    Binding="{Binding ShortId}"
                                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}">
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Credential Types"
                                    Binding="{Binding CredentialTypes}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Password" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✗"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=HasPassword}" Value="True">
                                                <Setter Property="Text" Value="✓"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="OTP" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✗"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=HasOtp}" Value="True">
                                                <Setter Property="Text" Value="✓"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="🔄 Restore Selected"
                    Style="{StaticResource CircularPrimaryButton}"
                    IsDefault="True"
                    Click="RestoreButton_Click"
                    IsEnabled="{Binding CanRestore}"
                    ToolTip="Restore the selected credential to a new account"
                    AutomationProperties.Name="Restore Selected Credential"
                    Margin="0,0,10,0"/>
            <Button Content="✖ Close"
                    Style="{StaticResource CircularSecondaryButton}"
                    IsCancel="True"
                    Click="CloseButton_Click"
                    ToolTip="Close"
                    AutomationProperties.Name="Close"/>
        </StackPanel>
    </Grid>
</Window>
