<Window x:Class="FFXIManager.Views.TemplateNavigationTuner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FFXIManager.ViewModels"
        xmlns:models="clr-namespace:FFXIManager.Models"
        mc:Ignorable="d"
        Title="Template Navigation Tuner" Height="600" Width="1000"
        Background="{DynamicResource BackgroundBrush}">
    <!-- DataContext is set in code-behind via DI -->

    <Window.Resources>
        <ObjectDataProvider x:Key="TargetAppEnum" MethodName="GetValues" ObjectType="{x:Type vm:TemplateNavigationTunerViewModel+TargetApp}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:TemplateNavigationTunerViewModel+TargetApp"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Converter to show/hide coordinate columns based on Action type -->
        <local:IsClickActionToVisibilityConverter x:Key="IsClickActionConverter"
                                                   xmlns:local="clr-namespace:FFXIManager.Converters"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Left Panel: Templates List -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="📁 Templates"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,0,0,10"/>

                <!-- Templates ListBox -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,0,10">
                    <ListBox ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate}"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Padding="4"/>
                </Border>

                <!-- Refresh Button -->
                <Button Grid.Row="2"
                        Content="🔄 Refresh"
                        Style="{StaticResource InfoButton}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <!-- Right Panel: Configuration -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top: Navigation Configuration -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- First Row: Post Delay, Target -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Post Delay:" VerticalAlignment="Center" Width="90"/>
                        <TextBox Width="100"
                                 Text="{Binding CurrentNavigation.PostNavigationDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,15,0"/>
                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <TextBlock Text="Target:" VerticalAlignment="Center" Width="60"/>
                        <ComboBox Width="120"
                                  ItemsSource="{Binding Source={StaticResource TargetAppEnum}}"
                                  SelectedItem="{Binding SelectedTarget}"/>
                    </StackPanel>

                    <!-- Second Row: Description -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Description:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding CurrentNavigation.Description, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Middle: Sequence DataGrid -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,10">
                <DockPanel>
                    <!-- Toolbar -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨️ Navigation Sequence"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>
                            <Button Content="➕"
                                    Style="{StaticResource CircularSuccessButton}"
                                    Command="{Binding AddStepCommand}"
                                    ToolTip="Add New Step"
                                    Width="32" Height="32"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding CurrentNavigation.Sequence}"
                              Style="{StaticResource DataGridBase}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Action"
                                                    SelectedItemBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="120">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="ItemsSource" Value="{x:Static vm:TemplateNavigationTunerViewModel.SupportedActions}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="ItemsSource" Value="{x:Static vm:TemplateNavigationTunerViewModel.SupportedActions}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTemplateColumn Header="X" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClickX, StringFormat=N2}"
                                                   Style="{StaticResource DataGridCenteredTextCellStyle}"
                                                   Visibility="{Binding Action, Converter={StaticResource IsClickActionConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ClickX, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center"
                                                 BorderThickness="0"
                                                 Visibility="{Binding Action, Converter={StaticResource IsClickActionConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Y" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClickY, StringFormat=N2}"
                                                   Style="{StaticResource DataGridCenteredTextCellStyle}"
                                                   Visibility="{Binding Action, Converter={StaticResource IsClickActionConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ClickY, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center"
                                                 BorderThickness="0"
                                                 Visibility="{Binding Action, Converter={StaticResource IsClickActionConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Count"
                                                Binding="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenteredTextCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Delay (ms)"
                                                Binding="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenteredTextCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Actions" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️"
                                                Style="{StaticResource CircularSmallButton}"
                                                Background="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove Step"
                                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Bottom: Status and Actions -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Indicator -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource InfoBackgroundBrush}"
                            BorderBrush="{DynamicResource InfoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Status}"
                                       Foreground="{DynamicResource InfoTextBrush}"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="400"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal">
                        <Button Content="🧪"
                                Style="{StaticResource CircularWarningButton}"
                                Command="{Binding TestCommand}"
                                ToolTip="Test Navigation (Live on Target Window)"
                                Margin="0,0,8,0"/>
                        <Button Content="💾"
                                Style="{StaticResource CircularSuccessButton}"
                                Command="{Binding SaveCommand}"
                                ToolTip="Save Navigation Configuration"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

