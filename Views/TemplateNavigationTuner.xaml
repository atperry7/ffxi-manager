<Window x:Class="FFXIManager.Views.TemplateNavigationTuner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FFXIManager.ViewModels"
        xmlns:models="clr-namespace:FFXIManager.Models"
        mc:Ignorable="d"
        Title="Template Navigation Tuner" Height="600" Width="1000"
        Background="{DynamicResource BackgroundBrush}">
    <!-- DataContext is set in code-behind via DI -->

    <Window.Resources>
        <ObjectDataProvider x:Key="TargetAppEnum" MethodName="GetValues" ObjectType="{x:Type vm:TemplateNavigationTunerViewModel+TargetApp}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:TemplateNavigationTunerViewModel+TargetApp"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Converter to show/hide coordinate columns based on Action type -->
        <local:IsClickActionToVisibilityConverter x:Key="IsClickActionConverter"
                                                   xmlns:local="clr-namespace:FFXIManager.Converters"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Template Selection Header -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- ROW 0: Template Selection & Info Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Dropdown & Buttons -->
                    <RowDefinition Height="Auto"/>  <!-- Info Bar -->
                </Grid.RowDefinitions>

                <!-- Selection Row -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="📁 Template:"
                               VerticalAlignment="Center"
                               Width="90"
                               FontWeight="SemiBold"/>
                    <ComboBox Width="500"
                              ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              Margin="0,0,10,0"/>
                    <Button Content="🔄"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource CircularInfoButton}"
                            Width="32" Height="32"
                            ToolTip="Refresh Template List"
                            Margin="0,0,5,0"/>
                    <Button Content="📁"
                            Command="{Binding ReplaceImageCommand}"
                            Style="{StaticResource CircularWarningButton}"
                            Width="32" Height="32"
                            ToolTip="Replace Template Image"/>
                </StackPanel>

                <!-- Info Row -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="📊 Info:"
                               Width="90"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="{Binding Metadata.Name, Mode=OneWay}"/>
                        <Run Text=" | "/>
                        <Run Text="{Binding TemplateImageWidth, StringFormat='W:{0:F0}', Mode=OneWay}"/>
                        <Run Text="×"/>
                        <Run Text="{Binding TemplateImageHeight, StringFormat='H:{0:F0}', Mode=OneWay}"/>
                        <Run Text=" | Confidence: "/>
                        <Run Text="{Binding Metadata.ConfidenceThreshold, StringFormat='P0', Mode=OneWay}"/>
                        <Run Text=" | Version: "/>
                        <Run Text="{Binding Metadata.Version, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Main Content (2 columns) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>  <!-- Image Preview: 40% -->
                <ColumnDefinition Width="3*"/>  <!-- Navigation Config: 60% -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Template Image Preview with Click Overlays -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header -->
                        <RowDefinition Height="*"/>     <!-- Image -->
                        <RowDefinition Height="Auto"/>  <!-- Legend -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0"
                               Text="🖼️ Template Preview"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,10"/>

                    <!-- Image with Overlay Canvas -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,10">
                        <!-- Viewbox scales the entire Grid (image + markers) proportionally -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <!-- Grid with explicit dimensions matching template size for pixel-perfect alignment -->
                            <Grid Width="{Binding TemplateImageWidth}"
                                  Height="{Binding TemplateImageHeight}">
                                <!-- Template Image at native size (no stretching) -->
                                <Image Source="{Binding TemplateImage}"
                                       Stretch="None"/>

                                <!-- Canvas overlay with same dimensions for pixel-perfect marker positioning -->
                                <Canvas Width="{Binding TemplateImageWidth}"
                                        Height="{Binding TemplateImageHeight}"
                                        ClipToBounds="True">
                                    <!-- Click Markers -->
                                    <ItemsControl ItemsSource="{Binding ClickMarkers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <!-- Outer Glow -->
                                                    <Ellipse Width="24" Height="24"
                                                             Fill="{Binding MarkerColor}"
                                                             Opacity="0.3"
                                                             Margin="-12,-12,0,0"/>

                                                    <!-- Marker Circle -->
                                                    <Ellipse Width="18" Height="18"
                                                             Fill="{Binding MarkerColor}"
                                                             Stroke="White"
                                                             StrokeThickness="2"
                                                             Margin="-9,-9,0,0"/>

                                                    <!-- Label -->
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="-9,-9,0,0"
                                                               Width="18"
                                                               Height="18"
                                                               TextAlignment="Center"/>

                                                    <!-- Tooltip -->
                                                    <Grid.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Description}" FontWeight="Bold"/>
                                                                <TextBlock>
                                                                    <Run Text="Position: ("/>
                                                                    <Run Text="{Binding X, StringFormat='{}{0:F0}'}"/>
                                                                    <Run Text=", "/>
                                                                    <Run Text="{Binding Y, StringFormat='{}{0:F0}'}"/>
                                                                    <Run Text=")"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Grid.ToolTip>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <!-- Legend -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <StackPanel>
                            <TextBlock Text="Click Points:"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding ClickMarkers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Ellipse Width="12" Height="12"
                                                     Fill="{Binding MarkerColor}"
                                                     Margin="0,0,6,0"/>
                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                                                <Run Text="{Binding Label}" FontWeight="Bold"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding Description}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Navigation Configuration -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top: Nav Config Header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- First Row: Post Delay, Target -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Post Delay:" VerticalAlignment="Center" Width="90"/>
                        <TextBox Width="100"
                                 Text="{Binding CurrentNavigation.PostNavigationDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,15,0"/>
                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <TextBlock Text="Target:" VerticalAlignment="Center" Width="60"/>
                        <ComboBox Width="120"
                                  ItemsSource="{Binding Source={StaticResource TargetAppEnum}}"
                                  SelectedItem="{Binding SelectedTarget}"/>
                    </StackPanel>

                    <!-- Second Row: Description -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Description:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding CurrentNavigation.Description, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Middle: Sequence DataGrid -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,10">
                <DockPanel>
                    <!-- Toolbar -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨️ Navigation Sequence"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>
                            <Button Content="➕"
                                    Style="{StaticResource CircularSuccessButton}"
                                    Command="{Binding AddStepCommand}"
                                    ToolTip="Add New Step"
                                    Width="32" Height="32"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding CurrentNavigation.Sequence}"
                              Style="{StaticResource DataGridBase}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Action"
                                                    SelectedItemBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="120">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="ItemsSource" Value="{x:Static vm:TemplateNavigationTunerViewModel.SupportedActions}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="ItemsSource" Value="{x:Static vm:TemplateNavigationTunerViewModel.SupportedActions}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTemplateColumn Header="X" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClickX, StringFormat=N2}"
                                                   Style="{StaticResource DataGridCenteredTextCellStyle}"
                                                   Visibility="{Binding Action, Converter={StaticResource IsClickActionConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ClickX, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center"
                                                 BorderThickness="0"
                                                 Visibility="{Binding Action, Converter={StaticResource IsClickActionConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Y" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClickY, StringFormat=N2}"
                                                   Style="{StaticResource DataGridCenteredTextCellStyle}"
                                                   Visibility="{Binding Action, Converter={StaticResource IsClickActionConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ClickY, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center"
                                                 BorderThickness="0"
                                                 Visibility="{Binding Action, Converter={StaticResource IsClickActionConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Count"
                                                Binding="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenteredTextCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Delay (ms)"
                                                Binding="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenteredTextCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Actions" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️"
                                                Style="{StaticResource CircularSmallButton}"
                                                Background="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove Step"
                                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Bottom: Status and Actions -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Indicator -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource InfoBackgroundBrush}"
                            BorderBrush="{DynamicResource InfoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Status}"
                                       Foreground="{DynamicResource InfoTextBrush}"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="400"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal">
                        <Button Content="🧪"
                                Style="{StaticResource CircularWarningButton}"
                                Command="{Binding TestCommand}"
                                ToolTip="Test Navigation (Live on Target Window)"
                                Margin="0,0,8,0"/>
                        <Button Content="💾"
                                Style="{StaticResource CircularSuccessButton}"
                                Command="{Binding SaveCommand}"
                                ToolTip="Save Navigation Configuration"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Close Right Column Grid (Grid.Column="1") -->
            </Grid>
        <!-- Close Main Content Grid (Grid.Row="1") -->
        </Grid>
    <!-- Close Outer Grid (Margin="15") -->
    </Grid>
</Window>

