<UserControl x:Class="FFXIManager.Views.AutoLoginQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Queue Status Colors -->
        <Style x:Key="QueueStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Queue Status Header -->
        <GroupBox Grid.Row="0" Header="Auto-Login Queue" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="{Binding QueueStatusDisplay}"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding QueueProgressDisplay}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Queue Control Buttons -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="▶️"
                            Style="{StaticResource CircularPrimaryButton}"
                            Command="{Binding StartQueueCommand}"
                            ToolTip="Start Queue"
                            Visibility="{Binding IsQueueExecuting, Converter={StaticResource InverseBoolToVisConverter}}"
                            Margin="0,0,5,0"/>

                    <Button Content="⏸️"
                            Style="{StaticResource CircularWarningButton}"
                            Command="{Binding PauseQueueCommand}"
                            ToolTip="Pause Queue"
                            Visibility="{Binding IsQueuePaused, Converter={StaticResource InverseBoolToVisConverter}}"
                            Margin="0,0,5,0"/>

                    <Button Content="▶️"
                            Style="{StaticResource CircularInfoButton}"
                            Command="{Binding ResumeQueueCommand}"
                            ToolTip="Resume Queue"
                            Visibility="{Binding IsQueuePaused, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,5,0"/>

                    <Button Content="⏹️"
                            Style="{StaticResource CircularDangerButton}"
                            Command="{Binding StopQueueCommand}"
                            ToolTip="Stop Queue"
                            Visibility="{Binding IsQueueExecuting, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,5,0"/>

                    <Button Content="⏭️"
                            Style="{StaticResource CircularWarningButton}"
                            Command="{Binding SkipCurrentCommand}"
                            ToolTip="Skip Current Item"
                            Visibility="{Binding CurrentItem, Converter={StaticResource NullToVisibilityConverter}}"
                            Margin="0,0,5,0"/>

                    <Button Content="↺"
                            Style="{StaticResource CircularSecondaryButton}"
                            Command="{Binding ResetQueueCommand}"
                            ToolTip="Reset Queue (set all items back to pending)"
                            Visibility="{Binding IsQueueExecuting, Converter={StaticResource InverseBoolToVisConverter}}"
                            Margin="0,0,5,0"/>
                </StackPanel>

                <!-- Overall Progress Bar -->
                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             Value="{Binding OverallProgress, Mode=OneWay}"
                             Maximum="100"
                             Height="8"
                             Margin="0,10,0,0"
                             Visibility="{Binding IsQueueExecuting, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>
        </GroupBox>

        <!-- Current Item Detail (shown when queue is executing) -->
        <GroupBox Grid.Row="1"
                  Header="Current Login Progress"
                  Margin="0,0,0,10"
                  Visibility="{Binding CurrentItem, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Current Item Info -->
                <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,5">
                    <Run Text="Logging in:"/>
                    <Run Text="{Binding CurrentItem.DisplayName, Mode=OneWay}" Foreground="{DynamicResource InfoBrush}"/>
                    <Run Text="from profile"/>
                    <Run Text="{Binding CurrentItem.ProfileName, Mode=OneWay}" Foreground="{DynamicResource InfoBrush}"/>
                </TextBlock>

                <!-- Current Step -->
                <TextBlock Grid.Row="1"
                           Text="{Binding CurrentItem.StatusMessage}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,5"/>

                <!-- Current Step Progress -->
                <ProgressBar Grid.Row="2"
                             Value="{Binding CurrentItem.CurrentStepProgress, Mode=OneWay}"
                             Maximum="100"
                             Height="10"/>
            </Grid>
        </GroupBox>

        <!-- Queue Items -->
        <GroupBox Grid.Row="2" Header="Queue Items" MinHeight="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Empty Queue Message -->
                <TextBlock Grid.Row="0"
                           Text="No items in queue"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontStyle="Italic"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Visibility="{Binding TotalQueueItems, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                <!-- Queue Items DataGrid -->
                <DataGrid Grid.Row="0"
                          Style="{StaticResource DataGridBase}"
                          ItemsSource="{Binding QueueItems}"
                          SelectedItem="{Binding SelectedQueueItem}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          Visibility="{Binding TotalQueueItems, Converter={StaticResource ZeroToInverseVisibilityConverter}}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🔄 Retry" Command="{Binding RetryFailedCommand}"/>
                            <MenuItem Header="🗑️ Remove" Command="{Binding RemoveFromQueueCommand}"/>
                            <Separator/>
                            <MenuItem Header="⬆️ Move Up" Command="{Binding MoveUpCommand}"/>
                            <MenuItem Header="⬇️ Move Down" Command="{Binding MoveDownCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenteredTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Account" Width="150" MinWidth="120">
                            <DataGridTextColumn.Binding>
                                <Binding Path="DisplayName" Mode="OneWay" UpdateSourceTrigger="PropertyChanged"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Profile" Width="100" MinWidth="80">
                            <DataGridTextColumn.Binding>
                                <Binding Path="ProfileName" Mode="OneWay" UpdateSourceTrigger="PropertyChanged"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource QueueStatusTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay, Mode=OneWay}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenteredTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Actions" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Retry Button -->
                                        <Button Content="🔄"
                                                Style="{StaticResource CircularSmallButton}"
                                                Background="{DynamicResource InfoBrush}"
                                                Command="{Binding DataContext.RetryItemParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Retry Failed Item"
                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"
                                                Margin="2"/>

                                        <!-- Remove Button -->
                                        <Button Content="🗑️"
                                                Style="{StaticResource CircularSmallButton}"
                                                Background="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveItemParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove from Queue"
                                                Margin="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Queue Management Buttons -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Visibility="{Binding TotalQueueItems, Converter={StaticResource ZeroToInverseVisibilityConverter}}">
                    <Button Content="⬆️"
                            Style="{StaticResource CircularInfoButton}"
                            Command="{Binding MoveUpCommand}"
                            ToolTip="Move Selected Item Up"
                            Margin="0,0,5,0"/>
                    <Button Content="⬇️"
                            Style="{StaticResource CircularInfoButton}"
                            Command="{Binding MoveDownCommand}"
                            ToolTip="Move Selected Item Down"
                            Margin="0,0,5,0"/>
                    <Button Content="🔄"
                            Style="{StaticResource CircularWarningButton}"
                            Command="{Binding RetryFailedCommand}"
                            ToolTip="Retry Selected Failed Item"
                            Margin="0,0,5,0"/>
                    <Button Content="🗑️"
                            Style="{StaticResource CircularDangerButton}"
                            Command="{Binding RemoveFromQueueCommand}"
                            ToolTip="Remove Selected Item"
                            Margin="0,0,10,0"/>
                    <Button Content="🗑️🗑️"
                            Style="{StaticResource CircularDangerButton}"
                            Command="{Binding ClearQueueCommand}"
                            ToolTip="Clear All Items"
                            FontSize="10"/>
                </StackPanel>
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>