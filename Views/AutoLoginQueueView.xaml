<UserControl x:Class="FFXIManager.Views.AutoLoginQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Queue Status Colors -->
        <Style x:Key="QueueStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Profile Row Style for Queue Items with hover/selection highlighting -->
        <Style x:Key="ProfileAwareRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="ValidationErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <TextBlock Foreground="Red" Margin="2,0,0,0" Text="!" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Hover highlight -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}"/>
                </Trigger>

                <!-- Selection highlight -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DataGridSelectionBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DataGridSelectionBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="2,0,0,0"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                </Trigger>

                <!-- Selected + Hover -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource DataGridSelectionBrush}"/>
                    <Setter Property="Opacity" Value="1.0"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                </MultiTrigger>

                <!-- In-progress row styling overrides -->
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Queue Status Header -->
        <GroupBox Grid.Row="0" Header="Auto-Login Queue" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="{Binding QueueStatusDisplay}"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding QueueProgressDisplay}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Queue Control Buttons -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <!-- Open Workflow Editor -->
                    <Button Content="⚙️"
                            Style="{StaticResource CircularInfoButton}"
                            Command="{Binding OpenWorkflowEditorCommand}"
                            ToolTip="Open Workflow Editor - Customize auto-login workflows"
                            Margin="0,0,10,0"/>
                    <Button Content="▶️"
                            Style="{StaticResource CircularPrimaryButton}"
                            Command="{Binding StartQueueCommand}"
                            ToolTip="Start Queue"
                            Visibility="{Binding CanShowStartButton, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,5,0"/>

                    <Button Content="⏸️"
                            Style="{StaticResource CircularWarningButton}"
                            Command="{Binding PauseQueueCommand}"
                            ToolTip="Pause Queue"
                            Visibility="{Binding CanShowPauseButton, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,5,0"/>

                    <Button Content="▶️"
                            Style="{StaticResource CircularInfoButton}"
                            Command="{Binding ResumeQueueCommand}"
                            ToolTip="Resume Queue"
                            Visibility="{Binding CanShowResumeButton, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,5,0"/>

                    <Button Content="⏹️"
                            Style="{StaticResource CircularDangerButton}"
                            Command="{Binding StopQueueCommand}"
                            ToolTip="Stop Queue"
                            Visibility="{Binding CanShowStopButton, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,5,0"/>

                    <Button Content="⏭️"
                            Style="{StaticResource CircularWarningButton}"
                            Command="{Binding SkipCurrentCommand}"
                            ToolTip="Skip Current Item"
                            Visibility="{Binding CurrentItem, Converter={StaticResource NullToVisibilityConverter}}"
                            Margin="0,0,5,0"/>

                    <Button Content="↺"
                            Style="{StaticResource CircularSecondaryButton}"
                            Command="{Binding ResetQueueCommand}"
                            ToolTip="Reset Queue (set all items back to pending)"
                            Visibility="{Binding CanShowResetButton, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,5,0"/>
                </StackPanel>

                <!-- Enhanced Stacked Color-Coded Progress Bar -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Height="10" Margin="0,10,0,0"
                        CornerRadius="5"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding ShowProgressBars, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <!-- Layer 1: Background/Pending (bottom layer) -->
                        <ProgressBar Value="100" Maximum="100"
                                     Style="{StaticResource PendingProgressBarStyle}"/>

                        <!-- Layer 2: All processed items (total progress) -->
                        <ProgressBar Value="{Binding ProcessedPercentage, Mode=OneWay}" Maximum="100"
                                     Style="{StaticResource FailedProgressBarStyle}"/>

                        <!-- Layer 3: Completed + Cancelled items (non-failed) -->
                        <ProgressBar Value="{Binding CompletedAndCancelledPercentage, Mode=OneWay}" Maximum="100"
                                     Style="{StaticResource CancelledProgressBarStyle}"/>

                        <!-- Layer 4: Only completed items (green on top) -->
                        <ProgressBar Value="{Binding CompletedPercentage, Mode=OneWay}" Maximum="100"
                                     Style="{StaticResource CompletedProgressBarStyle}"/>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Current Item Detail (always visible) -->
        <GroupBox Grid.Row="1"
                  Header="Login Progress"
                  Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Enhanced Active Queue Item Info -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1"
                        Visibility="{Binding CurrentItem, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Account and Profile Info -->
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2">
                                <Run Text="🎮" FontSize="16"/>
                                <Run Text="Logging in:"/>
                                <Run Text="{Binding CurrentItem.DisplayName, Mode=OneWay}"
                                     Foreground="{DynamicResource InfoBrush}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="Profile:"/>
                                <Run Text="{Binding CurrentItem.ProfileName, Mode=OneWay}"
                                     Foreground="{DynamicResource InfoBrush}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Duration Display -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrentItem.DurationDisplay, Mode=OneWay}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding CurrentItem.CurrentTaskDisplay, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Enhanced Idle State Info -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="6" Padding="16,12" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Visibility="{Binding CurrentItem, Converter={StaticResource NullToInverseVisibilityConverter}}">
                    <TextBlock Text="{Binding IdleStateMessage}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>


                <!-- Enhanced Idle Step Status -->
                <TextBlock Grid.Row="2"
                           Text="{Binding IdleStepMessage}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13"
                           FontStyle="Italic"
                           Margin="0,0,0,8"
                           TextAlignment="Center"
                           Visibility="{Binding CurrentItem, Converter={StaticResource NullToInverseVisibilityConverter}}"/>

                <!-- Active Task Progress -->
                <ProgressBar Grid.Row="3"
                             Value="{Binding CurrentItem.OverallProgress, Mode=OneWay}"
                             Maximum="100"
                             Height="12"
                             Style="{StaticResource ActiveProgressBarStyle}"
                             Visibility="{Binding CurrentItem, Converter={StaticResource NullToVisibilityConverter}}"/>

                <!-- Idle Progress Bar -->
                <ProgressBar Grid.Row="3"
                             Value="{Binding OverallProgress, Mode=OneWay}"
                             Maximum="100"
                             Height="12"
                             Style="{StaticResource SmoothProgressBarStyle}"
                             Visibility="{Binding CurrentItem, Converter={StaticResource NullToInverseVisibilityConverter}}"/>
            </Grid>
        </GroupBox>

        <!-- Queue Items -->
        <GroupBox Grid.Row="2" Header="Queue Items" MinHeight="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Empty Queue Message -->
                <TextBlock Grid.Row="0"
                           Text="No items in queue"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontStyle="Italic"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Visibility="{Binding TotalQueueItems, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                <!-- Queue Items DataGrid -->
                <DataGrid Grid.Row="0"
                          Style="{StaticResource DataGridBase}"
                          RowStyle="{StaticResource ProfileAwareRowStyle}"
                          ItemsSource="{Binding QueueItems}"
                          SelectedItem="{Binding SelectedQueueItem}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          Visibility="{Binding TotalQueueItems, Converter={StaticResource ZeroToInverseVisibilityConverter}}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="⬆️ Move Up" Command="{Binding MoveUpCommand}"/>
                            <MenuItem Header="⬇️ Move Down" Command="{Binding MoveDownCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenteredTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Account" Width="150" MinWidth="120">
                            <DataGridTextColumn.Binding>
                                <Binding Path="DisplayName" Mode="OneWay" UpdateSourceTrigger="PropertyChanged"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Profile" Width="100" MinWidth="80">
                            <DataGridTextColumn.Binding>
                                <Binding Path="ProfileName" Mode="OneWay" UpdateSourceTrigger="PropertyChanged"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource QueueStatusTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay, Mode=OneWay}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenteredTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Actions" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Login Now Button -->
                                        <Button Content="🚀"
                                                Style="{StaticResource CircularSmallButton}"
                                                Background="{DynamicResource SuccessBrush}"
                                                Command="{Binding DataContext.LoginNowParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Login Now (immediate single account login)"
                                                AutomationProperties.Name="Login Now"
                                                Margin="2"/>

                                        <!-- Remove Button -->
                                        <Button Content="🗑️"
                                                Style="{StaticResource CircularSmallButton}"
                                                Background="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveItemParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove from Queue"
                                                Margin="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Queue Management Buttons (Non-redundant actions only) -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Visibility="{Binding TotalQueueItems, Converter={StaticResource ZeroToInverseVisibilityConverter}}">
                    <Button Content="⬆️"
                            Style="{StaticResource CircularInfoButton}"
                            Command="{Binding MoveUpCommand}"
                            ToolTip="Move Selected Item Up"
                            Margin="0,0,5,0"/>
                    <Button Content="⬇️"
                            Style="{StaticResource CircularInfoButton}"
                            Command="{Binding MoveDownCommand}"
                            ToolTip="Move Selected Item Down"
                            Margin="0,0,10,0"/>
                    <Button Content="🗑️🗑️"
                            Style="{StaticResource CircularDangerButton}"
                            Command="{Binding ClearQueueCommand}"
                            ToolTip="Clear All Items"
                            FontSize="10"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Statistics Panel -->
        <GroupBox Grid.Row="3" Header="Statistics" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Statistics Display -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Logins -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding TotalLoginsDisplay}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>

                    <!-- Success Rate -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding SuccessRateDisplay}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource SuccessBrush}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>

                    <!-- Average Time -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding AverageTimeDisplay}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>

                    <!-- Toggle Button -->
                    <Button Grid.Column="3"
                            Content="{Binding StatsScopeLabel}"
                            Style="{StaticResource CircularInfoButton}"
                            Command="{Binding ToggleStatsScopeCommand}"
                            ToolTip="Toggle between Session and All-Time statistics"
                            Padding="8,4"/>
                </Grid>
            </Grid>
        </GroupBox>



    </Grid>
</UserControl>
