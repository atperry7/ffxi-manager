<Window x:Class="FFXIManager.Views.ImageCropperDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Template Region" Height="700" Width="900"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Instructions -->
            <RowDefinition Height="*"/>     <!-- Image with selection -->
            <RowDefinition Height="Auto"/>  <!-- Selection info -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Instructions -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📐 Select Template Region"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    Drag on the image below to select the region you want to use as the template.
                    If your screenshot is already the correct size, click "Use Full Image".
                </TextBlock>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    ⚠️ Please ensure that the title bar is not included for center-relative flows.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Image with selection overlay -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                Margin="0,0,0,10">
            <Viewbox x:Name="ImageViewbox" Stretch="Uniform" StretchDirection="Both">
                <Grid x:Name="ImageGrid"
                      Width="{Binding ImageWidth}"
                      Height="{Binding ImageHeight}">
                    <!-- Image canvas for selection -->
                    <Canvas x:Name="ImageCanvas"
                            Width="{Binding ImageWidth}"
                            Height="{Binding ImageHeight}"
                            Background="Transparent"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                            Cursor="Cross">

                        <!-- Source Image -->
                        <Image Source="{Binding SourceImage}"
                               Width="{Binding ImageWidth}"
                               Height="{Binding ImageHeight}"
                               Stretch="Fill"/>

                        <!-- Selection overlay (semi-transparent darkening) -->
                        <Rectangle Canvas.Left="0"
                                   Canvas.Top="0"
                                   Width="{Binding ImageWidth}"
                                   Height="{Binding ImageHeight}"
                                   Fill="Black"
                                   Opacity="0.5"/>

                        <!-- Clear selection area (shows original image) -->
                        <Rectangle Canvas.Left="{Binding SelectionX}"
                                   Canvas.Top="{Binding SelectionY}"
                                   Width="{Binding SelectionWidth}"
                                   Height="{Binding SelectionHeight}"
                                   Fill="White"
                                   Opacity="0.5"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Selection border -->
                        <Rectangle Canvas.Left="{Binding SelectionX}"
                                   Canvas.Top="{Binding SelectionY}"
                                   Width="{Binding SelectionWidth}"
                                   Height="{Binding SelectionHeight}"
                                   Stroke="{DynamicResource AccentBrush}"
                                   StrokeThickness="2"
                                   StrokeDashArray="5 3"
                                   Fill="Transparent"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Canvas>
                </Grid>
            </Viewbox>
        </Border>

        <!-- Selection info -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding SelectionInfo}"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontWeight="Medium"
                       TextAlignment="Center"/>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="🖼️"
                    Command="{Binding UseFullImageCommand}"
                    Style="{StaticResource CircularPrimaryButton}"
                    Width="36"
                    Height="36"
                    Margin="0,0,10,0"
                    ToolTip="Use the entire image without cropping"/>

            <Button Grid.Column="2"
                    Content="✂️"
                    Command="{Binding ApplyCropCommand}"
                    Style="{StaticResource CircularSuccessButton}"
                    Width="36"
                    Height="36"
                    Margin="0,0,10,0"
                    ToolTip="Crop to the selected region"/>

            <Button Grid.Column="3"
                    Content="❌"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource CircularSecondaryButton}"
                    Width="36"
                    Height="36"
                    ToolTip="Cancel and close this dialog"/>
        </Grid>
    </Grid>
</Window>
