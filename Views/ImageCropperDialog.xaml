<Window x:Class="FFXIManager.Views.ImageCropperDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Template Region" Height="700" Width="900"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Button styles -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#107C10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#107C10"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Instructions -->
            <RowDefinition Height="*"/>     <!-- Image with selection -->
            <RowDefinition Height="Auto"/>  <!-- Selection info -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Instructions -->
        <Border Grid.Row="0"
                Background="#2D2D2D"
                BorderBrush="#555555"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📐 Select Template Region"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="#CCCCCC">
                    Drag on the image below to select the region you want to use as the template.
                    If your screenshot is already the correct size, click "Use Full Image".
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Image with selection overlay -->
        <Border Grid.Row="1"
                Background="#252525"
                BorderBrush="#555555"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                Margin="0,0,0,10">
            <Viewbox x:Name="ImageViewbox" Stretch="Uniform" StretchDirection="Both">
                <Grid x:Name="ImageGrid"
                      Width="{Binding ImageWidth}"
                      Height="{Binding ImageHeight}">
                    <!-- Image canvas for selection -->
                    <Canvas x:Name="ImageCanvas"
                            Width="{Binding ImageWidth}"
                            Height="{Binding ImageHeight}"
                            Background="Transparent"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                            Cursor="Cross">

                        <!-- Source Image -->
                        <Image Source="{Binding SourceImage}"
                               Width="{Binding ImageWidth}"
                               Height="{Binding ImageHeight}"
                               Stretch="Fill"/>

                        <!-- Selection overlay (semi-transparent darkening) -->
                        <Rectangle Canvas.Left="0"
                                   Canvas.Top="0"
                                   Width="{Binding ImageWidth}"
                                   Height="{Binding ImageHeight}"
                                   Fill="Black"
                                   Opacity="0.5"/>

                        <!-- Clear selection area (shows original image) -->
                        <Rectangle Canvas.Left="{Binding SelectionX}"
                                   Canvas.Top="{Binding SelectionY}"
                                   Width="{Binding SelectionWidth}"
                                   Height="{Binding SelectionHeight}"
                                   Fill="White"
                                   Opacity="0.5"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Selection border -->
                        <Rectangle Canvas.Left="{Binding SelectionX}"
                                   Canvas.Top="{Binding SelectionY}"
                                   Width="{Binding SelectionWidth}"
                                   Height="{Binding SelectionHeight}"
                                   Stroke="DodgerBlue"
                                   StrokeThickness="2"
                                   StrokeDashArray="5 3"
                                   Fill="Transparent"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Canvas>
                </Grid>
            </Viewbox>
        </Border>

        <!-- Selection info -->
        <Border Grid.Row="2"
                Background="#2D2D2D"
                BorderBrush="#555555"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding SelectionInfo}"
                       Foreground="White"
                       FontWeight="Medium"
                       TextAlignment="Center"/>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Use Full Image"
                    Command="{Binding UseFullImageCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="140"
                    Margin="0,0,10,0"
                    ToolTip="Use the entire image without cropping"/>

            <Button Grid.Column="2"
                    Content="Apply Crop"
                    Command="{Binding ApplyCropCommand}"
                    Style="{StaticResource SuccessButton}"
                    Width="120"
                    Margin="0,0,10,0"
                    ToolTip="Crop to the selected region"/>

            <Button Grid.Column="3"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Width="100"
                    ToolTip="Cancel and close this dialog"/>
        </Grid>
    </Grid>
</Window>
