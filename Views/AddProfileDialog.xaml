<Window x:Class="FFXIManager.Views.AddProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Profile" Height="240" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Create New Backup Profile" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <Label Grid.Row="1" Content="Backup Name:" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox Grid.Row="2" x:Name="BackupNameTextBox" Margin="0,4,0,0" Height="28"
                 Text="{Binding NewBackupName, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="✓" 
                    Style="{StaticResource CircularSuccessButton}"
                    IsDefault="True"
                    Command="{Binding CreateBackupCommand}"
                    ToolTip="Create Profile"
                    AutomationProperties.Name="Create Profile"
                    Margin="0,0,8,0"/>
            <Button Content="✖" 
                    Style="{StaticResource CircularSecondaryButton}"
                    IsCancel="True"
                    ToolTip="Cancel"
                    AutomationProperties.Name="Cancel"/>
        </StackPanel>
    </Grid>
</Window>
