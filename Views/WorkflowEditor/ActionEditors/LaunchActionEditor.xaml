<UserControl x:Class="FFXIManager.Views.WorkflowEditor.ActionEditors.LaunchActionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Launch Application Action"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

        <!-- Application Selection -->
        <GroupBox Grid.Row="1" Header="Application" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Select the application to launch:" Margin="0,0,0,5"/>
                <ComboBox x:Name="ApplicationComboBox"
                          ItemsSource="{Binding AvailableApplications, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding ApplicationName, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,5"/>
                <TextBlock Text="Applications are configured in Settings → External Applications"
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- Launch Options -->
        <GroupBox Grid.Row="2" Header="Launch Behavior" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <CheckBox Content="Skip if application is not configured"
                          IsChecked="{Binding AllowSkipIfNotConfigured, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                          Margin="0,0,0,8"
                          ToolTip="If enabled, step will succeed even if the application is not configured in Settings"/>
                <CheckBox Content="Skip if application is already running"
                          IsChecked="{Binding AllowSkipIfRunning, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                          ToolTip="If enabled, step will succeed without launching if the process is already running"/>
            </StackPanel>
        </GroupBox>

        <!-- Template Detection (Optional) -->
        <GroupBox Grid.Row="3" Header="UI Readiness Detection (Optional)" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Wait for specific UI element to confirm application is ready:"
                           TextWrapping="Wrap" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding TemplatePath, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,5,0" VerticalContentAlignment="Center"
                             ToolTip="Template filename (without .png extension)"
                             Background="{DynamicResource TextBoxBackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"/>
                    <Button Grid.Column="1" Content="Browse..." Width="80"
                            Click="BrowseTemplate_Click"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ButtonTextBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"/>
                </Grid>
                <TextBlock Text="Leave empty to use process detection only"
                           FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Template Matching Parameters -->
        <GroupBox Grid.Row="4" Header="Template Matching (if template specified)" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Confidence Threshold -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Confidence Threshold:" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0.5" Maximum="1.0"
                                Value="{Binding ConfidenceThreshold, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ConfidenceThreshold, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=F2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Higher = more precise match required (default: 0.80)"
                               FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Retry Configuration -->
        <GroupBox Grid.Row="5" Header="Retry Configuration" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Retry Attempts -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Retry Attempts:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding RetryAttempts, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="Default: 20" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Retry Delay -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Retry Delay (ms):" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding RetryDelayMs, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="Default: 500ms" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Post-Action Delay -->
        <GroupBox Grid.Row="6" Header="Post-Action Delay" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Delay after successful launch (milliseconds):" Margin="0,0,0,5"/>
                <TextBox Text="{Binding DelayMs, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="Time to wait after application launches before next action"
                           FontSize="11" Foreground="Gray" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- Description -->
        <GroupBox Grid.Row="7" Header="Description" Margin="0,0,0,10">
            <TextBox Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     Height="60" VerticalScrollBarVisibility="Auto"
                     Margin="5"/>
        </GroupBox>

        <!-- Help Text -->
        <Border Grid.Row="8" Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource InfoTextBrush}">
                <Run Text="💡 Tip: " FontWeight="SemiBold"/>
                <Run Text="Launch actions wait for the process to start. If a template is specified, the action also waits for the UI element to appear. This ensures the application is fully ready before proceeding."/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
