<UserControl x:Class="FFXIManager.Views.WorkflowEditor.ActionEditors.KeyboardActionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Keyboard Action"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

        <!-- Key Selection -->
        <GroupBox Grid.Row="1" Header="Key to Press" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Select the key to send:" Margin="0,0,0,5"/>
                <ComboBox x:Name="KeyComboBox"
                          ItemsSource="{Binding AvailableKeys}"
                          SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,5"/>
                <TextBlock Text="Common keys: Tab, Enter, Arrow keys, Escape"
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- Repeat Count -->
        <GroupBox Grid.Row="2" Header="Repeat Configuration" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Number of times to press the key:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Set to 0 to skip this action dynamically (useful for character slot selection)"
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- Delay Configuration -->
        <GroupBox Grid.Row="3" Header="Delay After Each Press" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Delay in milliseconds after each key press:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Default: 200ms for navigation keys, 500ms for confirmation keys"
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- Description -->
        <GroupBox Grid.Row="4" Header="Description" Margin="0,0,0,10">
            <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     Height="60" VerticalScrollBarVisibility="Auto"
                     Margin="5"
                     ToolTip="Describe what this action does (e.g., 'Tab to password field', 'Confirm selection')"/>
        </GroupBox>

        <!-- Help Text -->
        <Border Grid.Row="5" Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource InfoTextBrush}">
                <Run Text="💡 Tip: " FontWeight="SemiBold"/>
                <Run Text="Keyboard actions are the most reliable way to navigate UI. Use Tab to move between fields, arrow keys to navigate menus, and Enter to confirm selections."/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
