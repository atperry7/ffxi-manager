<UserControl x:Class="FFXIManager.Views.WorkflowEditor.ActionEditors.WaitActionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Wait Action"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

        <!-- Delay Configuration -->
        <GroupBox Grid.Row="1" Header="Wait Duration" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Delay in milliseconds:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <!-- Quick Presets -->
                <TextBlock Text="Quick Presets:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <WrapPanel>
                    <Button Content="100ms" Click="SetDelay_Click" Tag="100" Margin="0,0,5,5" Width="60"/>
                    <Button Content="250ms" Click="SetDelay_Click" Tag="250" Margin="0,0,5,5" Width="60"/>
                    <Button Content="500ms" Click="SetDelay_Click" Tag="500" Margin="0,0,5,5" Width="60"/>
                    <Button Content="1s" Click="SetDelay_Click" Tag="1000" Margin="0,0,5,5" Width="60"/>
                    <Button Content="2s" Click="SetDelay_Click" Tag="2000" Margin="0,0,5,5" Width="60"/>
                    <Button Content="3s" Click="SetDelay_Click" Tag="3000" Margin="0,0,5,5" Width="60"/>
                    <Button Content="5s" Click="SetDelay_Click" Tag="5000" Margin="0,0,5,5" Width="60"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- Description -->
        <GroupBox Grid.Row="2" Header="Description" Margin="0,0,0,10">
            <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     Height="60" VerticalScrollBarVisibility="Auto"
                     Margin="5"
                     ToolTip="Describe why this wait is needed (e.g., 'Wait for UI to load', 'Pause for animation')"/>
        </GroupBox>

        <!-- Help Text -->
        <Border Grid.Row="3" Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource InfoTextBrush}">
                <Run Text="💡 Tip: " FontWeight="SemiBold"/>
                <Run Text="Wait actions introduce explicit delays in the workflow. Use them when you need to pause for UI animations, loading screens, or other time-based transitions. Most actions already include built-in delays, so only add Wait actions when additional time is needed."/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
