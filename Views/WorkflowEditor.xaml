<Window x:Class="FFXIManager.Views.WorkflowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FFXIManager.Views"
        xmlns:converters="clr-namespace:FFXIManager.Converters"
        mc:Ignorable="d"
        Title="Workflow Editor - Auto-Login Customization"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Inverse Boolean to Visibility Converter -->
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>

        <!-- Action-based Visibility Converters -->
        <converters:IsClickActionToVisibilityConverter x:Key="IsClickActionToVisConverter"/>
        <converters:IsNotClickActionToVisibilityConverter x:Key="IsNotClickActionToVisConverter"/>

        <!-- Step Template Selector -->
        <DataTemplate x:Key="WorkflowStepTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="12,8"
                    Margin="0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Order Indicator -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Order}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Width="30"
                               Margin="0,0,12,0"/>

                    <!-- Step Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Status Indicators -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <TextBlock Text="✓"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="14"
                                   Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisConverter}}"
                                   Margin="0,0,8,0"
                                   ToolTip="Step is enabled"/>
                        <TextBlock Text="○"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="14"
                                   Visibility="{Binding IsOptional, Converter={StaticResource BoolToVisConverter}}"
                                   Margin="0,0,8,0"
                                   ToolTip="Step is optional"/>
                        <TextBlock Text="{Binding EstimatedDurationSeconds, StringFormat={}~{0}s}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title and Description -->
                <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center">
                    <TextBlock Text="Workflow Editor"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Create and customize auto-login workflows without code changes"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="💾"
                            Command="{Binding SaveWorkflowCommand}"
                            Width="36"
                            Height="36"
                            Margin="0,0,4,0"
                            Style="{StaticResource CircularPrimaryButton}"
                            ToolTip="Save all changes to the selected workflow"/>
                    <Button Content="✅"
                            Command="{Binding ValidateWorkflowCommand}"
                            Width="36"
                            Height="36"
                            Margin="0,0,4,0"
                            Style="{StaticResource CircularSecondaryButton}"
                            ToolTip="Validate workflow structure and step configuration"/>
                    <Button Content="🧪"
                            Command="{Binding TestWorkflowCommand}"
                            Width="36"
                            Height="36"
                            Margin="0,0,4,0"
                            Style="{StaticResource CircularSecondaryButton}"
                            ToolTip="Test the selected workflow with a dry run"/>
                    <Button Content="🗑️"
                            Command="{Binding DeleteWorkflowCommand}"
                            Width="36"
                            Height="36"
                            Style="{StaticResource CircularDangerButton}"
                            ToolTip="Permanently delete the selected workflow"/>
                </StackPanel>

                <!-- Unsaved Changes Indicator -->
                <Border Grid.Column="1" Grid.Row="1"
                        Background="{DynamicResource WarningBrush}"
                        CornerRadius="6"
                        Padding="8,4"
                        Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisConverter}}"
                        HorizontalAlignment="Right">
                    <TextBlock Text="⚠ Unsaved Changes"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="6,6,0,0"
                                        Padding="16,8"
                                        Margin="0,0,4,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="1,2,1,0"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource PillBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>

            <!-- Workflows Tab -->
            <TabItem Header="Workflows">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Workflow List -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Workflow List Header -->
                            <TextBlock Grid.Row="0"
                                       Text="Available Workflows"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- Workflow List -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Workflows}"
                                     SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,8"
                                                Margin="0,4"
                                                Background="{DynamicResource CardBackgroundBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <Border Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="DEFAULT"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource DangerBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="READ-ONLY"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Description}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Workflow Actions Bar -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="4"
                                    Margin="0,8,0,0">
                                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="➕"
                                            Command="{Binding CreateNewWorkflowCommand}"
                                            Width="36"
                                            Height="36"
                                            Margin="2"
                                            Style="{StaticResource CircularPrimaryButton}"
                                            ToolTip="Create a new workflow from scratch"/>
                                    <Button Content="📋"
                                            Command="{Binding CloneWorkflowCommand}"
                                            Width="36"
                                            Height="36"
                                            Margin="2"
                                            Style="{StaticResource CircularSecondaryButton}"
                                            ToolTip="Duplicate the selected workflow to create a customized version"/>
                                    <Button Content="📥"
                                            Command="{Binding ImportWorkflowCommand}"
                                            Width="36"
                                            Height="36"
                                            Margin="2"
                                            Style="{StaticResource CircularSecondaryButton}"
                                            ToolTip="Import a workflow from a JSON file"/>
                                    <Button Content="📤"
                                            Command="{Binding ExportWorkflowCommand}"
                                            Width="36"
                                            Height="36"
                                            Margin="2"
                                            Style="{StaticResource CircularSecondaryButton}"
                                            ToolTip="Export the selected workflow to a JSON file"/>
                                    <Button Content="🔄"
                                            Command="{Binding RestoreDefaultsCommand}"
                                            Width="36"
                                            Height="36"
                                            Margin="2"
                                            Style="{StaticResource CircularWarningButton}"
                                            ToolTip="Restore default workflows from application directory"/>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Workflow Details -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Workflow Properties"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,16"/>

                                <Grid IsEnabled="{Binding CanEditWorkflow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Name -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Name:"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding SelectedWorkflow.Name, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12"/>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="Description:"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,8,0,12"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding SelectedWorkflow.Description, UpdateSourceTrigger=PropertyChanged}"
                                             Height="60"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,12"/>

                                    <!-- Version -->
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="Version:"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,12"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding SelectedWorkflow.Version, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12"/>

                                    <!-- Flags -->
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="Flags:"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
                                        <CheckBox Content="Is Default Workflow"
                                                  IsChecked="{Binding SelectedWorkflow.IsDefault}"
                                                  Margin="0,0,0,4"/>
                                    </StackPanel>

                                    <!-- Tags -->
                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Text="Tags:"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,12"/>
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding SelectedWorkflow.TagsDisplay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12"
                                             ToolTip="Enter tags separated by commas"/>

                                    <!-- Step Count -->
                                    <TextBlock Grid.Row="5" Grid.Column="0"
                                               Text="Steps:"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="{Binding SelectedWorkflow.Steps.Count, Mode=OneWay}"/>
                                        <Run Text="steps configured"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Read-Only Checkbox (outside disabled grid to allow toggling) -->
                                <CheckBox Content="Read Only"
                                          IsChecked="{Binding SelectedWorkflow.IsReadOnly}"
                                          IsEnabled="{Binding HasWorkflowSelected}"
                                          Margin="0,8,0,0"
                                          ToolTip="Mark this workflow as read-only to prevent accidental modifications"/>


                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Steps Tab -->
            <TabItem Header="Step Editor">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step List -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Workflow Steps"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,8"/>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding WorkflowSteps}"
                                     SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource WorkflowStepTemplate}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                            <!-- Step Actions Bar -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="4"
                                    Margin="0,8,0,0">
                                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="➕"
                                            Command="{Binding AddStepCommand}"
                                            Width="36"
                                            Height="36"
                                            Margin="2"
                                            Style="{StaticResource CircularPrimaryButton}"
                                            ToolTip="Add a new step to the workflow"/>
                                    <Button Content="🗑️"
                                            Command="{Binding RemoveStepCommand}"
                                            Width="36"
                                            Height="36"
                                            Margin="2"
                                            Style="{StaticResource CircularDangerButton}"
                                            ToolTip="Permanently remove the selected step from the workflow"/>
                                    <Button Content="↑"
                                            Command="{Binding MoveStepUpCommand}"
                                            Width="36"
                                            Height="36"
                                            Margin="2"
                                            Style="{StaticResource CircularSecondaryButton}"
                                            ToolTip="Move the selected step up in execution order"/>
                                    <Button Content="↓"
                                            Command="{Binding MoveStepDownCommand}"
                                            Width="36"
                                            Height="36"
                                            Margin="2"
                                            Style="{StaticResource CircularSecondaryButton}"
                                            ToolTip="Move the selected step down in execution order"/>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Step Properties -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel IsEnabled="{Binding HasStepSelected}">
                                <TextBlock Text="Step Properties"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Display Name -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Display Name:"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding SelectedStep.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12"/>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="Description:"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,8,0,12"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding SelectedStep.Description, UpdateSourceTrigger=PropertyChanged}"
                                             Height="50"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Margin="0,0,0,12"/>

                                    <!-- Template Path -->
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="Template:"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,8,0,12"/>
                                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Side: Path and Buttons -->
                                        <StackPanel Grid.Column="0">
                                            <TextBox Text="{Binding SelectedStep.TemplatePath, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,8"
                                                     ToolTip="Path to template image file"/>

                                            <!-- Template Management Buttons -->
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="📷 Select Image"
                                                        Command="{Binding SelectTemplateImageCommand}"
                                                        Width="140"
                                                        Height="28"
                                                        Margin="0,0,4,0"
                                                        Style="{StaticResource CircularPrimaryButton}"
                                                        ToolTip="Select a screenshot or image to create a template"/>
                                                <Button Content="🔄 Replace"
                                                        Command="{Binding ReplaceTemplateImageCommand}"
                                                        Width="100"
                                                        Height="28"
                                                        Style="{StaticResource CircularSecondaryButton}"
                                                        ToolTip="Replace the existing template image"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right Side: Thumbnail Preview -->
                                        <Border Grid.Column="1"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Margin="12,0,0,0"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                Visibility="{Binding HasTemplateImage, Converter={StaticResource BoolToVisConverter}}"
                                                ToolTip="Click to view full size"
                                                Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.3" Color="Black"/>
                                            </Border.Effect>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding TemplateImageSource}"
                                                   Width="120"
                                                   Height="100"
                                                   Stretch="Uniform"
                                                   Margin="4">
                                                <Image.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding ShowLargeTemplateImageCommand}"/>
                                                </Image.InputBindings>
                                            </Image>
                                        </Border>
                                    </Grid>

                                    <!-- Duration -->
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="Duration (seconds):"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,12"/>
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Text="{Binding SelectedStep.EstimatedDurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12"/>

                                    <!-- Max Retry Attempts -->
                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Text="Max Retries:"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,12"/>
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding SelectedStep.MaxRetryAttempts, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12"
                                             ToolTip="Number of detection attempts before giving up&#x0a;Example: 15 attempts = check screen 15 times at 1-second intervals&#x0a;&#x0a;Recommended: 10-15 for stable screens, 20-30 for slow transitions"/>

                                    <!-- Skip If Application Running -->
                                    <TextBlock Grid.Row="5" Grid.Column="0"
                                               Text="Skip If Running:"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,12"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1"
                                              ItemsSource="{Binding AvailableApplications}"
                                              SelectedValue="{Binding SelectedStep.SkipIfApplicationRunning, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Name"
                                              Margin="0,0,0,12"
                                              ToolTip="Skip this step if the selected application is already running&#x0a;&#x0a;Use Case: Skip PlayOnline navigation steps if POL Proxy is running&#x0a;&#x0a;Leave empty to never skip based on running applications">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="ToolTip" Value="{Binding ExecutablePath}"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>

                                    <!-- Flags -->
                                    <TextBlock Grid.Row="7" Grid.Column="0"
                                               Text="Flags:"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,12">
                                        <CheckBox Content="Enabled"
                                                  IsChecked="{Binding SelectedStep.IsEnabled}"
                                                  Margin="0,0,0,4"
                                                  ToolTip="Uncheck to skip this step entirely&#x0a;Disabled steps are never executed"/>
                                        <CheckBox Content="Optional (can skip on failure)"
                                                  IsChecked="{Binding SelectedStep.IsOptional}"
                                                  Margin="0,0,0,4"
                                                  ToolTip="Check if step failure should not abort the workflow&#x0a;Optional steps can be skipped on failure"/>
                                    </StackPanel>

                                    <!-- Step ID (Immutable) -->
                                    <TextBlock Grid.Row="8" Grid.Column="0"
                                               Text="Step ID:"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedStep.StepId}"
                                                   FontSize="11"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource InfoBrush}"
                                                CornerRadius="3"
                                                Padding="4,2"
                                                Margin="8,0,0,0"
                                                ToolTip="Step IDs are permanent and cannot be changed once created. They are used to reference steps in workflows.">
                                            <TextBlock Text="🔒 IMMUTABLE"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Navigation Sequence Section removed (legacy UI replaced by ActionSequenceEditor) -->


                                    <!-- Navigation Actions Master-Detail Editor -->
                                    <TextBlock Text="Actions Sequence"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,12"/>

                                    <!-- Navigation Actions DataGrid + Detail Panel -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Toolbar Buttons -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="➕"
                                                    Style="{StaticResource CircularPrimaryButton}"
                                                    Command="{Binding AddNavigationActionCommand}"
                                                    Width="32" Height="32"
                                                    ToolTip="Add a new action to the sequence"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="🗑️"
                                                    Style="{StaticResource CircularDangerButton}"
                                                    Command="{Binding RemoveNavigationActionCommand}"
                                                    Width="32" Height="32"
                                                    ToolTip="Remove the selected action"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="↑"
                                                    Style="{StaticResource CircularSecondaryButton}"
                                                    Command="{Binding MoveNavigationActionUpCommand}"
                                                    Width="32" Height="32"
                                                    ToolTip="Move action up in sequence"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="↓"
                                                    Style="{StaticResource CircularSecondaryButton}"
                                                    Command="{Binding MoveNavigationActionDownCommand}"
                                                    Width="32" Height="32"
                                                    ToolTip="Move action down in sequence"/>
                                        </StackPanel>

                                        <!-- DataGrid -->
                                        <DataGrid Grid.Row="1"
                                                  Style="{StaticResource DataGridBase}"
                                                  ItemsSource="{Binding NavigationActions}"
                                                  SelectedItem="{Binding SelectedNavigationAction, Mode=TwoWay}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  SelectionMode="Single"
                                                  Height="250"
                                                  Margin="0,0,0,12">
                                            <DataGrid.Columns>
                                                <!-- Type Column (editable ComboBox) -->
                                                <DataGridComboBoxColumn Header="Type" Width="100">
                                                    <DataGridComboBoxColumn.ElementStyle>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="ItemsSource">
                                                                <Setter.Value>
                                                                    <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                                                        <sys:String>Tab</sys:String>
                                                                        <sys:String>Enter</sys:String>
                                                                        <sys:String>Up</sys:String>
                                                                        <sys:String>Down</sys:String>
                                                                        <sys:String>Left</sys:String>
                                                                        <sys:String>Right</sys:String>
                                                                        <sys:String>Escape</sys:String>
                                                                        <sys:String>Click</sys:String>
                                                                        <sys:String>Launch</sys:String>
                                                                        <sys:String>Wait</sys:String>
                                                                        <sys:String>InputPassword</sys:String>
                                                                        <sys:String>InputOTP</sys:String>
                                                                        <sys:String>MemberSlot</sys:String>
                                                                        <sys:String>CharacterSlot</sys:String>
                                                                    </x:Array>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="SelectedItem" Value="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </Style>
                                                    </DataGridComboBoxColumn.ElementStyle>
                                                    <DataGridComboBoxColumn.EditingElementStyle>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="ItemsSource">
                                                                <Setter.Value>
                                                                    <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                                                        <sys:String>Tab</sys:String>
                                                                        <sys:String>Enter</sys:String>
                                                                        <sys:String>Up</sys:String>
                                                                        <sys:String>Down</sys:String>
                                                                        <sys:String>Left</sys:String>
                                                                        <sys:String>Right</sys:String>
                                                                        <sys:String>Escape</sys:String>
                                                                        <sys:String>Click</sys:String>
                                                                        <sys:String>Launch</sys:String>
                                                                        <sys:String>Wait</sys:String>
                                                                        <sys:String>InputPassword</sys:String>
                                                                        <sys:String>InputOTP</sys:String>
                                                                        <sys:String>MemberSlot</sys:String>
                                                                        <sys:String>CharacterSlot</sys:String>
                                                                    </x:Array>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="SelectedItem" Value="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </Style>
                                                    </DataGridComboBoxColumn.EditingElementStyle>
                                                </DataGridComboBoxColumn>

                                                <!-- Description Column (editable) -->
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="120">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Count Column (editable) -->
                                                <DataGridTextColumn Header="Count" Binding="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="60">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Delay Column (editable) -->
                                                <DataGridTextColumn Header="Delay (ms)" Binding="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextCellStyle}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Detail Panel (below grid for complex actions) -->
                                        <GroupBox Grid.Row="2" Header="Action Properties" Padding="12"
                                                  Visibility="{Binding HasNavigationActionSelected, Converter={StaticResource BoolToVisConverter}}"
                                                  Background="{DynamicResource CardBackgroundBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                            <StackPanel>
                                                    <TextBlock Text="Common Properties" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Action Type:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                                                  SelectedValuePath="Content"
                                                                  SelectedValue="{Binding SelectedNavigationAction.Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                            <ComboBoxItem Content="Tab"/>
                                                            <ComboBoxItem Content="Enter"/>
                                                            <ComboBoxItem Content="Up"/>
                                                            <ComboBoxItem Content="Down"/>
                                                            <ComboBoxItem Content="Left"/>
                                                            <ComboBoxItem Content="Right"/>
                                                            <ComboBoxItem Content="Escape"/>
                                                            <ComboBoxItem Content="Click"/>
                                                            <ComboBoxItem Content="Launch"/>
                                                            <ComboBoxItem Content="Wait"/>
                                                            <ComboBoxItem Content="InputPassword"/>
                                                            <ComboBoxItem Content="InputOTP"/>
                                                            <ComboBoxItem Content="MemberSlot"/>
                                                            <ComboBoxItem Content="CharacterSlot"/>
                                                        </ComboBox>

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" VerticalAlignment="Top" Margin="0,0,0,8"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                                 Text="{Binding SelectedNavigationAction.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Repeat Count:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedNavigationAction.Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Delay After (ms):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedNavigationAction.DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                                        <!-- Retry Attempts -->
                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Retry Attempts:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                                                                 Text="{Binding ActionRetryAttempts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Number of detection attempts before giving up&#x0a;Example: 30 attempts = check screen 30 times&#x0a;&#x0a;Recommended: 10-30 for UI detection, 30-60 for app launches"/>

                                                        <!-- Retry Delay -->
                                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Retry Delay (ms):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                                                                 Text="{Binding ActionRetryDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Milliseconds to wait between retry attempts&#x0a;Example: 500ms = half second between checks&#x0a;&#x0a;Recommended: 500-1000ms"/>

                                                        <!-- Template Path -->
                                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Template:" VerticalAlignment="Top" Margin="0,0,0,8"/>
                                                        <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBox Text="{Binding ActionTemplatePath, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="0,0,0,8"
                                                                         ToolTip="Template image for screen detection&#x0a;Leave empty if no template matching needed"/>

                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Content="📷 Select Image"
                                                                            Command="{Binding SelectActionTemplateImageCommand}"
                                                                            Width="140"
                                                                            Height="28"
                                                                            Margin="0,0,4,0"
                                                                            Style="{StaticResource CircularPrimaryButton}"
                                                                            ToolTip="Select a screenshot for template matching"/>
                                                                    <Button Content="🔄 Replace"
                                                                            Command="{Binding ReplaceActionTemplateImageCommand}"
                                                                            Width="100"
                                                                            Height="28"
                                                                            Style="{StaticResource CircularSecondaryButton}"
                                                                            ToolTip="Replace the existing template image"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Template Thumbnail Preview -->
                                                            <Border Grid.Column="1"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Margin="12,0,0,0"
                                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                                    Visibility="{Binding HasActionTemplateImage, Converter={StaticResource BoolToVisConverter}}"
                                                                    ToolTip="Click to view full size"
                                                                    Cursor="Hand">
                                                                <Border.Effect>
                                                                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.3" Color="Black"/>
                                                                </Border.Effect>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Image Source="{Binding ActionTemplateImageSource}"
                                                                       Width="120"
                                                                       Height="100"
                                                                       Stretch="Uniform"
                                                                       Margin="4">
                                                                    <Image.InputBindings>
                                                                        <MouseBinding Gesture="LeftClick"
                                                                                      Command="{Binding ShowLargeActionTemplateImageCommand}"/>
                                                                    </Image.InputBindings>
                                                                </Image>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Confidence Threshold -->
                                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Confidence:" VerticalAlignment="Center"/>
                                                        <Grid Grid.Row="7" Grid.Column="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider Grid.Column="0" Minimum="0.0" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                                    Value="{Binding ActionConfidenceThreshold, Mode=TwoWay}" Margin="0,0,8,0"
                                                                    ToolTip="Template match confidence threshold (0.0-1.0)&#x0a;Higher = more strict matching&#x0a;&#x0a;Recommended: 0.7-0.85"/>
                                                            <TextBox Grid.Column="1" Text="{Binding ActionConfidenceThreshold, StringFormat=F2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- Click Properties (visible only for Click actions) -->
                                                    <Border Visibility="{Binding SelectedNavigationAction, Converter={StaticResource IsClickActionToVisConverter}}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                                            Background="{DynamicResource SurfaceBrush}">
                                                        <StackPanel>
                                                            <TextBlock Text="Click Position" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                            <TextBlock Text="Coordinates are relative to the detected template (0.0 = left/top edge, 1.0 = right/bottom edge)"
                                                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="60"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Click X:" VerticalAlignment="Center"/>
                                                                <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                                        Value="{Binding SelectedNavigationAction.ClickX, Mode=TwoWay}" Margin="8,0"/>
                                                                <TextBox Grid.Column="2" Text="{Binding SelectedNavigationAction.ClickX, StringFormat=F2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </Grid>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="60"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Click Y:" VerticalAlignment="Center"/>
                                                                <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                                        Value="{Binding SelectedNavigationAction.ClickY, Mode=TwoWay}" Margin="8,0"/>
                                                                <TextBox Grid.Column="2" Text="{Binding SelectedNavigationAction.ClickY, StringFormat=F2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </Grid>

                                                            <Border Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                                                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,8,0,0">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Margin="0,0,0,3" Foreground="{DynamicResource InfoTextBrush}">Common Positions:</TextBlock>
                                                                    <TextBlock FontSize="10" Foreground="{DynamicResource InfoTextBrush}">• Center: X=0.5, Y=0.5</TextBlock>
                                                                    <TextBlock FontSize="10" Foreground="{DynamicResource InfoTextBrush}">• Top-Left: X=0.0, Y=0.0</TextBlock>
                                                                    <TextBlock FontSize="10" Foreground="{DynamicResource InfoTextBrush}">• Top-Right: X=1.0, Y=0.0</TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Launch Properties (visible only for Launch actions) -->
                                                    <Border Visibility="{Binding IsLaunchActionSelected, Converter={StaticResource BoolToVisConverter}}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                                            Background="{DynamicResource SurfaceBrush}">
                                                        <StackPanel>
                                                            <TextBlock Text="Application Launch Settings" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <!-- Application Name -->
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Application:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                                                          ItemsSource="{Binding AvailableApplications}"
                                                                          DisplayMemberPath="Name"
                                                                          SelectedValuePath="Name"
                                                                          SelectedValue="{Binding LaunchApplicationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          ToolTip="Select the application to launch (configured in Settings)"/>

                                                                <!-- Skip Options -->
                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Skip Options:" VerticalAlignment="Top"/>
                                                                <StackPanel Grid.Row="1" Grid.Column="1">
                                                                    <CheckBox Content="Skip if already running"
                                                                              IsChecked="{Binding LaunchAllowSkipIfRunning, Mode=TwoWay}"
                                                                              Margin="0,0,0,4"
                                                                              ToolTip="Skip launching if process is already running"/>
                                                                    <CheckBox Content="Skip if not configured"
                                                                              IsChecked="{Binding LaunchAllowSkipIfNotConfigured, Mode=TwoWay}"
                                                                              ToolTip="Skip without error if application is not in settings"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <TextBlock Text="💡 Configure external applications in Settings → External Applications"
                                                                       FontSize="10" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Wait Properties (visible only for Wait actions) -->
                                                    <Border Visibility="{Binding IsWaitActionSelected, Converter={StaticResource BoolToVisConverter}}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8"
                                                            Background="{DynamicResource SurfaceBrush}">
                                                        <StackPanel>
                                                            <TextBlock Text="Wait Duration" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                            <TextBlock Text="Use the 'Delay After (ms)' field above to set the wait duration."
                                                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- InputPassword Properties (visible only for InputPassword actions) -->
                                                    <Border Visibility="{Binding IsInputPasswordActionSelected, Converter={StaticResource BoolToVisConverter}}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                                            Background="{DynamicResource SurfaceBrush}">
                                                        <StackPanel>
                                                            <TextBlock Text="Password Input" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8">
                                                                Password will be retrieved from Windows Credential Manager using the account's stored credentials.
                                                            </TextBlock>
                                                            <TextBlock FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource InfoTextBrush}">Security Features:</TextBlock>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}">• Password masked in logs (shown as ****)</TextBlock>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}">• Cleared from memory after use</TextBlock>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8">• Optional template detection for field location</TextBlock>
                                                            <Border Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                                                    BorderThickness="1" CornerRadius="3" Padding="8">
                                                                <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource InfoTextBrush}">
                                                                    💡 Configure password in Settings → PlayOnline Accounts
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- InputOTP Properties (visible only for InputOTP actions) -->
                                                    <Border Visibility="{Binding IsInputOTPActionSelected, Converter={StaticResource BoolToVisConverter}}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                                            Background="{DynamicResource SurfaceBrush}">
                                                        <StackPanel>
                                                            <TextBlock Text="OTP Input" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8">
                                                                OTP code will be generated from the secret stored in Windows Credential Manager.
                                                            </TextBlock>
                                                            <TextBlock FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource InfoTextBrush}">Security Features:</TextBlock>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}">• OTP code masked in logs (shown as ******)</TextBlock>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}">• Cleared from memory after use</TextBlock>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8">• Optional template detection for field location</TextBlock>
                                                            <Border Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                                                    BorderThickness="1" CornerRadius="3" Padding="8">
                                                                <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource InfoTextBrush}">
                                                                    💡 Configure OTP secret in Settings → PlayOnline Accounts
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Slot Navigation Properties (visible for MemberSlot/CharacterSlot actions) -->
                                                    <Border Visibility="{Binding IsSlotActionSelected, Converter={StaticResource BoolToVisConverter}}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                                            Background="{DynamicResource SurfaceBrush}">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0} Navigation">
                                                                        <Binding Path="SelectedNavigationAction.Action"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>

                                                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8">
                                                                Navigates to the slot number defined in the account settings (POLMemberSlot or FFXICharacterSlot).
                                                            </TextBlock>

                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="Navigation Method:" VerticalAlignment="Center"/>
                                                                <ComboBox Grid.Column="1"
                                                                          SelectedItem="{Binding SlotNavigationMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                    <ComboBox.ItemsSource>
                                                                        <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                                                            <sys:String>Keyboard</sys:String>
                                                                            <sys:String>Click</sys:String>
                                                                        </x:Array>
                                                                    </ComboBox.ItemsSource>
                                                                </ComboBox>
                                                            </Grid>

                                                            <Border Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                                                    BorderThickness="1" CornerRadius="3" Padding="8">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource InfoTextBrush}">Navigation Methods:</TextBlock>
                                                                    <TextBlock FontSize="10" Foreground="{DynamicResource InfoTextBrush}">• Keyboard: Uses arrow keys (Home → Down/Right)</TextBlock>
                                                                    <TextBlock FontSize="10" Foreground="{DynamicResource InfoTextBrush}">• Click: Uses template match + click coordinates</TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </GroupBox>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12"
                Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="💡 Tip: "
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Changes to workflows are saved automatically when you click 'Save Changes'. Test your workflows before using them in production."
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3"
                Background="#CC000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading..."
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    
</Window>
